/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include "famig-layouts.dtsi"

/ {
    model = "famig";
    compatible = "famig";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,console = &cdc_acm_uart;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,battery = &vbatt;
        zmk,backlight = &leds;
        zmk,physical-layout = &famig_layout1;
        zmk,studio-rpc = &cdc_acm_uart;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
		  = <&gpio0 17 GPIO_ACTIVE_HIGH>  //0
		  , <&gpio1  9 GPIO_ACTIVE_HIGH>  //1
		  , <&gpio0 20 GPIO_ACTIVE_HIGH>  //2
		  , <&gpio0 13 GPIO_ACTIVE_HIGH>  //3
          , <&gpio0 22 GPIO_ACTIVE_HIGH>  //4
		  , <&gpio0 24 GPIO_ACTIVE_HIGH>  //5
		  , <&gpio1  0 GPIO_ACTIVE_HIGH>  //6
		  , <&gpio1  2 GPIO_ACTIVE_HIGH>  //7
		  , <&gpio1  4 GPIO_ACTIVE_HIGH>  //8
          , <&gpio0  9 GPIO_ACTIVE_HIGH>  //9
		  , <&gpio1  6 GPIO_ACTIVE_HIGH>  //9
		  , <&gpio0  8 GPIO_ACTIVE_HIGH>  //10
		  , <&gpio0 12 GPIO_ACTIVE_HIGH>  //11
		  , <&gpio0  7 GPIO_ACTIVE_HIGH>  //12
          , <&gpio1 10 GPIO_ACTIVE_HIGH>  //13
		  , <&gpio0  3 GPIO_ACTIVE_HIGH>  //14
		  , <&gpio0 28 GPIO_ACTIVE_HIGH>  //15
		  , <&gpio1 13 GPIO_ACTIVE_HIGH>  //16
		  , <&gpio0  2 GPIO_ACTIVE_HIGH>  //17
          , <&gpio0 29 GPIO_ACTIVE_HIGH>  //18
		  , <&gpio0 31 GPIO_ACTIVE_HIGH>  //19
            ;

        row-gpios
			= <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //0
			, <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //1
			, <&gpio0 30 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //2
			, <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //3
			, <&gpio0  6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //4
			, <&gpio0  1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  //5
            ;
    };

    famig_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <21>;
        rows = <6>;

        map = <
RC(0,0)           RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10)  RC(0,11)  RC(0,12)  RC(0,13)    RC(0,14)  RC(0,15)  RC(0,16)     RC(0,17)  RC(0,18)  RC(0,19)  RC(0,20)
RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10)  RC(1,11)  RC(1,12)  RC(1,13)    RC(1,14)  RC(1,15)  RC(1,16)     RC(1,17)  RC(1,18)  RC(1,19)  RC(1,20)
RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10)  RC(2,11)  RC(2,12)  RC(2,13)    RC(2,14)  RC(2,15)  RC(2,16)     RC(2,17)  RC(2,18)  RC(2,19)  RC(2,20)
RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10)  RC(3,11)            RC(3,13)                                     RC(3,17)  RC(3,18)  RC(3,19) 
RC(4,0)           RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)  RC(4,10)  RC(4,11)            RC(4,13)              RC(4,15)               RC(4,17)  RC(4,18)  RC(4,19)  RC(4,20)
RC(5,0)  RC(5,1)  RC(5,2)                             RC(5,6)                             RC(5,10)  RC(5,11)  RC(5,12)  RC(5,13)    RC(5,14)  RC(5,15)  RC(5,16)     RC(5,17)            RC(5,19) 
        >;
    };

    leds: leds {
        compatible = "gpio-leds";
        red_led: led_0 { 
            gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
        };
    };

    vbatt: vbatt {
         compatible = "zmk,battery-voltage-divider";
         io-channels = <&adc 2>;
         output-ohms = <2000000>;
         full-ohms = <(2000000 + 82000)>;
     };
};

&famig_layout1 {
    kscan = <&kscan>;
    transform = <&famig_transform>;
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

zephyr_udc0: &usbd {
    status = "okay";
    cdc_acm_uart: cdc_acm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        code_partition: partition@1000 {
            reg = <DT_SIZE_K(4) DT_SIZE_K(844)>;
        };

        storage_partition: partition@d4000 {
            reg = <DT_SIZE_K(848) DT_SIZE_K(128)>;
        };

        boot_partition: partition@f4000 {
            reg = <DT_SIZE_K(976) DT_SIZE_K(48)>;
        };
    };
};
